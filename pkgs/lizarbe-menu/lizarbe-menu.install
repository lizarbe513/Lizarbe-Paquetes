# Acciones de sistema (root) del paquete lizarbe-menu. Lo que es de cada usuario
# lo hace lizarbe-doctor desde los hooks de Omarchy.

post_install() { _lizarbe_system; }
post_upgrade() { _lizarbe_system; }

# Al quitar el paquete se va /etc/pacman.d/lizarbe.conf: hay que quitar también
# su Include de pacman.conf, o pacman dejaría de funcionar.
post_remove() {
  if [ -f /etc/pacman.conf ] && [ ! -e /etc/pacman.d/lizarbe.conf ]; then
    sed -i '\|^Include = /etc/pacman\.d/lizarbe\.conf$|d' /etc/pacman.conf
  fi
}

_lizarbe_system() {
  # Hook de pacman de versiones anteriores: corría como root y no actualizaba nada.
  rm -f /etc/pacman.d/hooks/00-lizarbe-update.hook

  # Idiomas que ofrece Lizarbe (español de España e inglés de EE. UU.): se generan si faltan.
  _lizarbe_locales

  # El repo de Lizarbe debe estar en pacman.conf para que `omarchy update` lo use.
  if [ -r /etc/pacman.d/lizarbe.conf ] && [ -f /etc/pacman.conf ] \
    && ! grep -qxF 'Include = /etc/pacman.d/lizarbe.conf' /etc/pacman.conf; then
    sed -i '0,/^\[core\]/s||Include = /etc/pacman.d/lizarbe.conf\n\n[core]|' /etc/pacman.conf
  fi
}

_lizarbe_locales() {
  [ -f /etc/locale.gen ] || return 0
  local changed=0 l
  for l in es_ES.UTF-8 en_US.UTF-8; do
    if ! grep -Eq "^$l UTF-8[[:space:]]*\$" /etc/locale.gen; then
      if grep -Eq "^#$l UTF-8" /etc/locale.gen; then
        sed -i "s/^#\($l UTF-8\)/\1/" /etc/locale.gen
      else
        echo "$l UTF-8" >>/etc/locale.gen
      fi
      changed=1
    fi
  done
  if [ "$changed" = 1 ] || ! locale -a 2>/dev/null | grep -qi '^es_ES\.utf-\?8$'; then
    locale-gen >/dev/null 2>&1 || true
  fi
}
