{
  "kdeconnect": {
    "icon": "\udb80\udd1c",
    "label": {
      "es": "KDE Connect",
      "en": "KDE Connect"
    },
    "aliases": [
      "kdeconnect",
      "phone"
    ],
    "description": {
      "es": "Vincular tu celular: notificaciones, archivos y portapapeles",
      "en": "Link your phone: notifications, files and clipboard"
    },
    "action": "uwsm-app -- lizarbe-kdeconnect"
  },
  "lizarbe": {
    "icon": "\udb82\udcc6",
    "label": {
      "es": "Centro Lizarbe",
      "en": "Lizarbe Center"
    },
    "aliases": [
      "lizarbe"
    ],
    "description": {
      "es": "Tema, identidad, software recomendado y actualizaciones",
      "en": "Theme, identity, recommended software and updates"
    },
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe lizarbe-tui"
  },
  "system": {
    "when": "false",
    "aliases": []
  },
  "power": {
    "like": "system"
  },
  "setup.monitors": {
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section pantallas"
  },
  "setup.keybindings": {
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section atajos"
  },
  "setup.input": {
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section teclado"
  },
  "setup.nightlight": {
    "icon": "\udb81\udd94",
    "label": {
      "es": "Luz nocturna",
      "en": "Night Light"
    },
    "description": {
      "es": "Filtro de luz azul",
      "en": "Blue light filter"
    },
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section luz"
  },
  "setup.screenshots": {
    "icon": "\udb83\ude51",
    "label": {
      "es": "Capturas",
      "en": "Screenshots"
    },
    "description": {
      "es": "Carpeta, tecla de captura y qu\u00e9 hacer con ellas",
      "en": "Folder, capture key and what to do with them"
    },
    "aliases": [
      "screenshots",
      "capturas",
      "print"
    ],
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section capturas"
  },
  "setup.notifications": {
    "icon": "\udb80\udc9a",
    "label": {
      "es": "Notificaciones",
      "en": "Notifications"
    },
    "description": {
      "es": "No molestar y qui\u00e9n muestra los avisos",
      "en": "Do not disturb and what shows the notices"
    },
    "aliases": [
      "notifications",
      "notificaciones",
      "avisos"
    ],
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-widgets lizarbe-widgets --section notificaciones"
  },
  "setup.compose": {
    "icon": "\udb81\uddca",
    "label": {
      "es": "Atajos de texto",
      "en": "Text Shortcuts"
    },
    "description": {
      "es": "Escribir s\u00edmbolos y frases con una secuencia",
      "en": "Type symbols and phrases with a key sequence"
    },
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section texto"
  },
  "setup.language": {
    "icon": "\uf1ab",
    "label": {
      "es": "Idioma",
      "en": "Language"
    },
    "description": {
      "es": "Idioma del sistema, el men\u00fa y las apps Lizarbe",
      "en": "System, menu and Lizarbe apps language"
    },
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section idioma"
  },
  "setup.autostart": {
    "icon": "\udb81\udc25",
    "label": {
      "es": "Inicio autom\u00e1tico",
      "en": "Startup Apps"
    },
    "description": {
      "es": "Programas que se abren al iniciar sesi\u00f3n",
      "en": "Programs that open when you log in"
    },
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section inicio"
  },
  "setup.network": {
    "when": "false",
    "aliases": []
  },
  "setup.default": {
    "when": "false",
    "aliases": []
  },
  "setup.plugin": {
    "when": "false",
    "aliases": []
  },
  "setup.security": {
    "when": "false",
    "aliases": []
  },
  "setup.config": {
    "when": "false",
    "aliases": []
  },
  "setup.direct-boot": {
    "when": "false",
    "aliases": []
  },
  "setup.reset": {
    "when": "false",
    "aliases": []
  },
  "setup.lz-network": {
    "like": "setup.network"
  },
  "setup.lz-default": {
    "like": "setup.default"
  },
  "setup.lz-plugin": {
    "like": "setup.plugin",
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-widgets lizarbe-widgets --section plugins"
  },
  "setup.lz-security": {
    "like": "setup.security"
  },
  "setup.lz-config": {
    "like": "setup.config"
  },
  "setup.lz-direct-boot": {
    "like": "setup.direct-boot"
  },
  "setup.lz-reset": {
    "like": "setup.reset"
  },
  "setup.config.looknfeel": {
    "icon": "\udb80\ude2e",
    "label": "looknfeel.lua",
    "when": "[[ -f ~/.config/hypr/looknfeel.lua ]]",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""
  },
  "setup.config.monitors": {
    "icon": "\udb80\ude2e",
    "label": "monitors.lua",
    "when": "[[ -f ~/.config/hypr/monitors.lua ]]",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""
  },
  "setup.config.bindings": {
    "icon": "\udb80\ude2e",
    "label": "bindings.lua",
    "when": "[[ -f ~/.config/hypr/bindings.lua ]]",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""
  },
  "setup.config.input": {
    "icon": "\udb80\ude2e",
    "label": "input.lua",
    "when": "[[ -f ~/.config/hypr/input.lua ]]",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/input.lua\""
  },
  "install.package": {
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-tienda lizarbe-tienda"
  },
  "install.aur": {
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-tienda lizarbe-tienda --fuente aur"
  },
  "style.hyprland": {
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section apariencia"
  },
  "style.temas": {
    "icon": "\udb80\udfd8",
    "label": {
      "es": "Crear tema",
      "en": "New Theme"
    },
    "description": {
      "es": "Crear y editar temas completos: colores, fondos, iconos y m\u00e1s",
      "en": "Create and edit complete themes: colors, wallpapers, icons and more"
    },
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-temas lizarbe-temas"
  },
  "style.widgets": {
    "icon": "\udb81\udd6e",
    "label": {
      "es": "Widgets y barra",
      "en": "Widgets & Bar"
    },
    "description": {
      "es": "Barra superior y widgets",
      "en": "Top bar and widgets"
    },
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-widgets lizarbe-widgets"
  }
}
