{
  "lizarbe": {
    "icon": "\udb82\udcc6",
    "label": "Centro Lizarbe",
    "aliases": [
      "lizarbe"
    ],
    "description": "Tema, identidad, software recomendado y actualizaciones",
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe lizarbe-tui"
  },
  "system": {
    "when": "false",
    "aliases": []
  },
  "power": {
    "like": "system"
  },
  "setup.monitors": {
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section pantallas"
  },
  "setup.keybindings": {
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section atajos"
  },
  "setup.input": {
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section teclado"
  },
  "setup.nightlight": {
    "icon": "\udb81\udd94",
    "label": "Luz nocturna",
    "description": "Filtro de luz azul",
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section luz"
  },
  "setup.compose": {
    "icon": "\udb81\uddca",
    "label": "Atajos de texto",
    "description": "Escribir s\u00edmbolos y frases con una secuencia",
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section texto"
  },
  "setup.network": {
    "when": "false",
    "aliases": []
  },
  "setup.default": {
    "when": "false",
    "aliases": []
  },
  "setup.plugin": {
    "when": "false",
    "aliases": []
  },
  "setup.security": {
    "when": "false",
    "aliases": []
  },
  "setup.config": {
    "when": "false",
    "aliases": []
  },
  "setup.direct-boot": {
    "when": "false",
    "aliases": []
  },
  "setup.reset": {
    "when": "false",
    "aliases": []
  },
  "setup.lz-network": {
    "like": "setup.network"
  },
  "setup.lz-default": {
    "like": "setup.default"
  },
  "setup.lz-plugin": {
    "like": "setup.plugin",
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-widgets lizarbe-widgets --section plugins"
  },
  "setup.lz-security": {
    "like": "setup.security"
  },
  "setup.lz-config": {
    "like": "setup.config"
  },
  "setup.lz-direct-boot": {
    "like": "setup.direct-boot"
  },
  "setup.lz-reset": {
    "like": "setup.reset"
  },
  "setup.config.looknfeel": {
    "icon": "\udb80\ude2e",
    "label": "looknfeel.lua",
    "when": "[[ -f ~/.config/hypr/looknfeel.lua ]]",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""
  },
  "setup.config.monitors": {
    "icon": "\udb80\ude2e",
    "label": "monitors.lua",
    "when": "[[ -f ~/.config/hypr/monitors.lua ]]",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""
  },
  "setup.config.bindings": {
    "icon": "\udb80\ude2e",
    "label": "bindings.lua",
    "when": "[[ -f ~/.config/hypr/bindings.lua ]]",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""
  },
  "setup.config.input": {
    "icon": "\udb80\ude2e",
    "label": "input.lua",
    "when": "[[ -f ~/.config/hypr/input.lua ]]",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/input.lua\""
  },
  "style.hyprland": {
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section apariencia"
  },
  "style.temas": {
    "icon": "\udb80\udfd8",
    "label": "Mis temas",
    "description": "Crear y editar temas de color",
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-escritorio lizarbe-escritorio --section temas"
  },
  "style.widgets": {
    "icon": "\udb81\udd6e",
    "label": "Widgets y barra",
    "description": "Barra superior y widgets",
    "action": "omarchy-launch-tui --app-id=org.omarchy.lizarbe-widgets lizarbe-widgets"
  }
}
