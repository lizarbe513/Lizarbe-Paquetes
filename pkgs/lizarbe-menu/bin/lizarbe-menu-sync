#!/usr/bin/env python3
"""Sincroniza las entradas de Lizarbe en el menú de Omarchy.

Escribe un bloque delimitado en ~/.config/omarchy/extensions/omarchy-menu.jsonc:

    // >>> lizarbe (gestionado)
    ...entradas...
    // <<< lizarbe

Lo demás del archivo (tus propias entradas y comentarios) no se toca. Antes de
guardar se comprueba que el resultado sea JSON válido (si no lo es, Omarchy
ignoraría todo el archivo) y se hace una copia de seguridad.

Idioma: con `--lang es` (o `lang = "es"` en ~/.config/lizarbe/ajustes.toml, o $LANG)
se traducen las etiquetas del menú de Omarchy copiando sus entradas con la etiqueta en
español. Con `en` se deja el inglés de Omarchy. Todo se regenera tras cada actualización.

Uso: lizarbe-menu-sync [--check] [--remove] [--quiet] [--no-refresh] [--lang es|en]
     [--file RUTA] [--source RUTA]
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time

START = "// >>> lizarbe (gestionado)"
END = "// <<< lizarbe"
# Entradas de versiones anteriores que ya no existen.
LEGACY_IDS = [
    "setup.config.meca",
    "setup.config.quickshell",
    "setup.widgets",
    "setup.escritorio",
    "lizarbe.pantallas",
    "lizarbe.atajos",
    "lizarbe.teclado",
    "lizarbe.luz",
    "lizarbe.texto",
    "lizarbe.apariencia",
    "lizarbe.temas",
    "lizarbe.widgets",
    "lizarbe.plugins",
    "lizarbe.centro",
    "lizarbe.avanzado",
]
# Campos que una entrada que reutiliza un id de Omarchy hereda del original si no los define
# (Omarchy reemplaza todos los campos al fusionar, así que si no se heredan quedan vacíos).
INHERIT = ("icon", "label", "aliases")
OMARCHY_DEFAULT = os.environ.get("OMARCHY_DEFAULT_MENU", "/usr/share/omarchy/default/omarchy/omarchy-menu.jsonc")

SHARE = os.environ.get("LIZARBE_SHARE", "/usr/share/lizarbe")


def strip_comments(text: str) -> str:
    """Quita las líneas que son solo comentario (lo que usa Omarchy)."""
    return "\n".join(l for l in text.splitlines() if not l.strip().startswith("//"))


def load_defaults(path: str) -> dict:
    """Entradas del menú de Omarchy ({} si no se puede leer)."""
    try:
        with open(path, encoding="utf-8") as f:
            text = re.sub(r",(\s*[}\]])", r"\1", strip_comments(f.read()))
        data = json.loads(text)
        return data.get("items", data) if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


LIKE_FIELDS = ("icon", "label", "aliases", "action", "when", "checked")


def inherit_defaults(entries: dict, defaults: dict) -> dict:
    """Completa las entradas con datos del menú de Omarchy.

    - Una entrada que reutiliza un id de Omarchy hereda icon/label/aliases si no los define.
    - `"like": "<id>"` crea una copia de otra entrada de Omarchy bajo un id nuevo (para
      cambiar su posición: el original se oculta con `"when": "false"`). Si el original es
      un submenú, la copia lo abre con `target`.
    """
    out = {}
    for key, val in entries.items():
        like = val.get("like")
        if like:
            base = defaults.get(like, {})
            new = {f: base[f] for f in LIKE_FIELDS if f in base and f not in val}
            new.update({k: v for k, v in val.items() if k != "like"})
            if "action" not in new and "target" not in new:
                new["target"] = like
            val = new
        else:
            base = defaults.get(key)
            if isinstance(base, dict) and "target" not in val:
                val = {**{f: base[f] for f in INHERIT if f in base and f not in val}, **val}
        out[key] = val
    return out


def detect_lang(explicit: str = "") -> str:
    """Idioma de Lizarbe: argumento, preferencias (~/.config/lizarbe/ajustes.toml) o $LANG."""
    if explicit in ("es", "en"):
        return explicit
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    try:
        import tomllib

        with open(os.path.join(cfg, "lizarbe", "ajustes.toml"), "rb") as f:
            lang = str(tomllib.load(f).get("lang", "")).lower()
        if lang in ("es", "en"):
            return lang
    except (OSError, ValueError, ImportError):
        pass
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(var, "")
        if v and v not in ("C", "POSIX"):
            return "es" if v.lower().startswith("es") else "en"
    return "en"


def load_translations(lang: str) -> dict:
    path = os.path.join(SHARE, "menu", "i18n", f"{lang}.json")
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def translate_defaults(defaults: dict, tr: dict) -> dict:
    """Entradas de Omarchy con la etiqueta traducida (las que no tienen traducción quedan igual)."""
    labels, ids = tr.get("labels", {}), tr.get("ids", {})
    out = {}
    for key, val in defaults.items():
        if not isinstance(val, dict):
            continue
        new = ids.get(key) or labels.get(val.get("label", ""))
        out[key] = {**val, "label": new} if new else val
    if "root" in ids and "root" not in out:
        out["root"] = {"label": ids["root"]}
    return out


def resolve_lang_fields(entries: dict, lang: str) -> dict:
    """Campos de nuestras entradas escritos como {"es": ..., "en": ...} se resuelven al idioma."""
    out = {}
    for key, val in entries.items():
        out[key] = {
            k: (v.get(lang) or v.get("en") or next(iter(v.values())) if isinstance(v, dict) and ("es" in v or "en" in v) else v)
            for k, v in val.items()
        }
    return out


def translated_copies(entries: dict, defaults_t: dict, defaults: dict) -> dict:
    """Copias completas de las entradas de Omarchy cuya etiqueta cambia (Omarchy reemplaza todos
    los campos al fusionar, así que hay que repetir `action`, `icon`, etc.). Las propias van primero."""
    out = dict(entries)
    for key, val in defaults_t.items():
        if key in out or (key in defaults and val.get("label") == defaults[key].get("label")):
            continue
        out[key] = {k: v for k, v in val.items() if k != "parent"}
    return out


def remove_block(text: str) -> str:
    out, skipping = [], False
    for line in text.splitlines():
        s = line.strip()
        if s == START:
            skipping = True
            continue
        if skipping:
            if s == END:
                skipping = False
            continue
        out.append(line)
    return "\n".join(out) + ("\n" if text.endswith("\n") else "")


def remove_entry(text: str, entry_id: str) -> str:
    """Borra la entrada `"id": { ... }` de nivel superior, si existe."""
    m = re.search(r'^[ \t]*"%s"[ \t]*:[ \t]*\{' % re.escape(entry_id), text, re.M)
    if not m:
        return text
    i = m.end() - 1
    depth, in_str, esc = 0, False, False
    while i < len(text):
        c = text[i]
        if in_str:
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
        elif c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                break
        i += 1
    end = i + 1
    rest = text[end:]
    rest = re.sub(r"^[ \t]*,?[ \t]*\n?", "", rest, count=1)
    return text[: m.start()] + rest


def fix_trailing_comma(text: str) -> str:
    """Quita la coma sobrante de la última entrada, antes de la llave final."""
    lines = text.split("\n")
    close = max((i for i, l in enumerate(lines) if l.strip().startswith("}")), default=-1)
    if close < 0:
        return text
    for i in range(close - 1, -1, -1):
        s = lines[i].strip()
        if not s or s.startswith("//"):
            continue
        if s.endswith(","):
            lines[i] = lines[i].rstrip()[:-1]
        break
    return "\n".join(lines)


def has_other_entries(text: str) -> bool:
    body = strip_comments(text)
    a, b = body.find("{"), body.rfind("}")
    return a >= 0 and b > a and body[a + 1 : b].strip() != ""


def render_block(entries: dict, followed_by_others: bool) -> str:
    lines = [START]
    items = list(entries.items())
    for n, (key, val) in enumerate(items):
        chunk = json.dumps({key: val}, ensure_ascii=False, indent=2)
        inner = chunk.splitlines()[1:-1]  # sin las llaves exteriores
        text = "\n".join(inner)
        last = n == len(items) - 1
        if not last or followed_by_others:
            text += ","
        lines.append(text)
    lines.append(END)
    return "\n".join(lines)


def build(current: str, entries: dict, remove: bool) -> str:
    text = remove_block(current)
    for entry_id in list(entries) + LEGACY_IDS:
        text = remove_entry(text, entry_id)
    text = fix_trailing_comma(text)
    if not text.strip():
        text = "{\n}\n"
    if remove:
        return text
    m = re.search(r"^\{[ \t]*$", text, re.M) or re.search(r"\{", text)
    if not m:
        raise ValueError("el archivo no tiene un objeto JSON")
    block = render_block(entries, has_other_entries(text))
    return text[: m.end()] + "\n" + block + text[m.end() :]


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--check", action="store_true", help="solo comprobar; sale con 1 si hay cambios")
    ap.add_argument("--remove", action="store_true", help="quitar las entradas de Lizarbe")
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--no-refresh", action="store_true")
    ap.add_argument("--lang", default="", choices=["", "es", "en"], help="idioma del menú (por defecto: el de Lizarbe)")
    ap.add_argument("--file", default=os.path.expanduser("~/.config/omarchy/extensions/omarchy-menu.jsonc"))
    ap.add_argument("--source", default=os.path.join(SHARE, "menu/lizarbe.jsonc"))
    a = ap.parse_args()

    def say(msg: str) -> None:
        if not a.quiet:
            print(msg)

    with open(a.source, encoding="utf-8") as f:
        source = json.load(f)
    lang = detect_lang(a.lang)
    defaults = load_defaults(OMARCHY_DEFAULT)
    defaults_t = translate_defaults(defaults, load_translations(lang) if lang != "en" else {})
    entries = inherit_defaults(resolve_lang_fields(source, lang), defaults_t)
    entries = translated_copies(entries, defaults_t, defaults)
    try:
        with open(a.file, encoding="utf-8") as f:
            current = f.read()
    except FileNotFoundError:
        current = ""

    # Si el archivo del usuario ya no es JSON válido no se toca: Omarchy lo
    # ignoraría entero y no sabemos cómo arreglarlo sin perder lo suyo.
    if current.strip():
        try:
            json.loads(strip_comments(current))
        except ValueError as e:
            print(f"lizarbe-menu-sync: {a.file} no es JSON válido ({e}); no se toca.", file=sys.stderr)
            return 2

    try:
        new = build(current, entries, a.remove)
        json.loads(strip_comments(new))
    except ValueError as e:
        print(f"lizarbe-menu-sync: el resultado no sería válido ({e}); no se escribe nada.", file=sys.stderr)
        return 2

    if new == current:
        say("Menú de Lizarbe al día.")
        return 0
    if a.check:
        say("El menú de Lizarbe necesita actualizarse.")
        return 1

    os.makedirs(os.path.dirname(a.file), exist_ok=True)
    if current:
        shutil.copy2(a.file, f"{a.file}.bak.{int(time.time())}")
    tmp = a.file + ".lizarbe.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(new)
    os.replace(tmp, a.file)
    say("Menú de Lizarbe actualizado.")
    if not a.no_refresh and shutil.which("omarchy"):
        subprocess.run(["omarchy", "menu", "refresh"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
