#!/usr/bin/env bash
# lizarbe-doctor — comprueba que Lizarbe esté bien integrado en Omarchy y, con
# --fix, lo arregla. Es seguro ejecutarlo las veces que quieras.
#
# Uso: lizarbe-doctor [--fix] [--quiet]
#   (sin opciones) solo informa y sale con 1 si hay algo que arreglar.
#
# Solo toca archivos de tu usuario (menú, reglas de ventana y hooks de Omarchy);
# nunca los archivos de los paquetes de Omarchy.
set -uo pipefail

SHARE="${LIZARBE_SHARE:-/usr/share/lizarbe}"
FIX=0
QUIET=0
for arg in "$@"; do
  case $arg in
    --fix) FIX=1 ;;
    --quiet) QUIET=1 ;;
    -h | --help)
      sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "Opción desconocida: $arg" >&2
      exit 2
      ;;
  esac
done

HYPR_DIR="$HOME/.config/hypr"
MAIN="$HYPR_DIR/hyprland.lua"
HOOKS_DIR="$HOME/.config/omarchy/hooks"

PROBLEMS=0
FIXED=0
RELOAD=0

say() { [[ $QUIET -eq 1 ]] || echo -e "$*"; }
ok() { say "  \033[32m✔\033[0m $*"; }
bad() { PROBLEMS=$((PROBLEMS + 1)); say "  \033[33m!\033[0m $*"; }
fixed() { FIXED=$((FIXED + 1)); say "  \033[32m↻\033[0m $*"; }

# Hace falta algo arreglable: informa y, con --fix, ejecuta "$@".
problem() { # mensaje comando...
  local msg=$1
  shift
  if [[ $FIX -eq 1 ]]; then
    if "$@"; then
      fixed "$msg (arreglado)"
    else
      bad "$msg (no se pudo arreglar)"
    fi
  else
    bad "$msg"
  fi
}

backup_once() { [[ -f $1 && ! -f $1.lizarbe-bak ]] && cp -p "$1" "$1.lizarbe-bak"; return 0; }

# ---------------------------------------------------------------- menú
check_menu() {
  say "Menú de Omarchy"
  if ! command -v lizarbe-menu-sync >/dev/null; then
    bad "falta lizarbe-menu-sync"
    return
  fi
  local rc=0
  lizarbe-menu-sync --check --quiet --no-refresh || rc=$?
  case $rc in
    0) ok "las entradas de Lizarbe están al día" ;;
    2) bad "tu omarchy-menu.jsonc no es JSON válido; no se toca (Omarchy lo ignora entero)" ;;
    *) problem "las entradas de Lizarbe del menú necesitan actualizarse" lizarbe-menu-sync --quiet ;;
  esac
}

# ---------------------------------------------------------------- reglas de ventana
LEGACY_REQUIRES=(hypr.lizarbe-escritorio hypr.lizarbe-widgets hypr.lizarbe-centro hypr.meca-qs)
LEGACY_RULE_FILES=(lizarbe-escritorio.lua lizarbe-widgets.lua lizarbe-centro.lua meca-qs.lua)

RULES_LUA='-- Gestionado por lizarbe-doctor: carga las reglas de ventana de Lizarbe.
pcall(dofile, "'"$SHARE"'/hypr/reglas.lua")'

write_rules() {
  mkdir -p "$HYPR_DIR" && printf '%s\n' "$RULES_LUA" >"$HYPR_DIR/lizarbe.lua"
}

add_require() {
  backup_once "$MAIN"
  printf '\n-- Lizarbe: reglas de ventana\nrequire("hypr.lizarbe")\n' >>"$MAIN"
}

drop_legacy_requires() {
  backup_once "$MAIN"
  local r esc
  for r in "${LEGACY_REQUIRES[@]}"; do
    esc=${r//./\\.}
    sed -i "/^require(\"$esc\")\$/d" "$MAIN"
  done
  # Comentarios que acompañaban a esas cargas.
  sed -i '/^-- \(lizarbe-widgets\|lizarbe-escritorio\|meca-qs (Quickshell)\|Centro Lizarbe\): ventana\(s\)\? flotante\(s\)\?$/d' "$MAIN"
  sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$MAIN"
  # Líneas en blanco seguidas: se dejan en una.
  sed -i '/^$/N;/^\n$/D' "$MAIN"
}

drop_legacy_files() {
  local f
  for f in "${LEGACY_RULE_FILES[@]}"; do rm -f "$HYPR_DIR/$f"; done
}

check_rules() {
  say "Reglas de ventana"
  if [[ ! -f $MAIN ]]; then
    ok "no hay hyprland.lua (nada que comprobar)"
    return
  fi
  if [[ ! -f $SHARE/hypr/reglas.lua ]]; then
    bad "falta $SHARE/hypr/reglas.lua (¿está instalado lizarbe-menu?)"
    return
  fi
  local changed=0
  if [[ ! -f $HYPR_DIR/lizarbe.lua ]] || [[ "$(cat "$HYPR_DIR/lizarbe.lua")" != "$RULES_LUA" ]]; then
    problem "lizarbe.lua no existe o está desactualizado" write_rules && changed=1
  else
    ok "lizarbe.lua al día"
  fi
  if ! grep -qx 'require("hypr.lizarbe")' "$MAIN"; then
    problem "hyprland.lua no carga las reglas de Lizarbe" add_require && changed=1
  else
    ok "hyprland.lua carga las reglas"
  fi
  local legacy=0 r
  for r in "${LEGACY_REQUIRES[@]}"; do
    grep -qxF "require(\"$r\")" "$MAIN" && legacy=1
  done
  for r in "${LEGACY_RULE_FILES[@]}"; do [[ -f $HYPR_DIR/$r ]] && legacy=1; done
  if [[ $legacy -eq 1 ]]; then
    problem "quedan cargas o archivos de reglas de versiones anteriores" bash -c "$(declare -f backup_once drop_legacy_requires drop_legacy_files); MAIN='$MAIN'; HYPR_DIR='$HYPR_DIR'; LEGACY_REQUIRES=(${LEGACY_REQUIRES[*]}); LEGACY_RULE_FILES=(${LEGACY_RULE_FILES[*]}); drop_legacy_requires; drop_legacy_files" && changed=1
  fi
  # Hyprland solo lee las reglas al iniciar o recargar: si una actualización trae reglas
  # nuevas (una app nueva que debe abrir flotante), hay que recargar una vez.
  local stamp="${XDG_STATE_HOME:-$HOME/.local/state}/lizarbe/reglas.sha256" now
  now=$(sha256sum "$SHARE/hypr/reglas.lua" | cut -d' ' -f1)
  if [[ "$(cat "$stamp" 2>/dev/null)" != "$now" ]]; then
    problem "las reglas de ventana de Hyprland no están cargadas" bash -c 'mkdir -p "$(dirname "$1")" && echo "$2" > "$1"' _ "$stamp" "$now" && changed=1
  fi
  [[ $changed -eq 1 && $FIX -eq 1 ]] && RELOAD=1
}

# ---------------------------------------------------------------- hooks
install_hook() { # origen destino
  mkdir -p "$(dirname "$2")" && install -m755 "$1" "$2"
}

check_hooks() {
  say "Hooks de Omarchy"
  local src rel dest
  for src in "$SHARE"/hooks/*/*.sh; do
    [[ -f $src ]] || continue
    rel=${src#"$SHARE"/hooks/}
    dest="$HOOKS_DIR/$rel"
    if [[ -f $dest ]] && cmp -s "$src" "$dest"; then
      ok "$rel"
    else
      problem "falta o está desactualizado el hook $rel" install_hook "$src" "$dest"
    fi
  done
}

# ---------------------------------------------------------------- restos de versiones anteriores
check_legacy() {
  say "Restos de versiones anteriores"
  local found=0 f
  # Meca y copias de desarrollo que ahora trae un paquete (ya están en /usr/bin).
  local apps="$HOME/.local/share/applications"
  for f in "$HOME/.local/bin/meca" "$HOME/.local/bin/meca-hyprconfig" "$HOME/.local/bin/meca-qs" \
    "$HOME/.local/bin/lizarbe-escritorio" "$HOME/.local/bin/lizarbe-widgets" "$HOME/.local/bin/lizarbe-temas" "$HOME/.local/bin/lizarbe-tienda" \
    "$HOME/.local/bin/lizarbe-hypr-rules" \
    "$HOME/.local/bin/lizarbe" "$HOME/.local/bin/lizarbe-tui" "$HOME/.local/bin/lizarbe-update" \
    "$apps/meca.desktop" "$apps/meca-qs.desktop" "$apps/lizarbe.desktop" \
    "$apps/lizarbe-escritorio.desktop" "$apps/lizarbe-widgets.desktop" "$apps/lizarbe-temas.desktop" "$apps/lizarbe-tienda.desktop" \
    "$HOOKS_DIR/post-update.d/99-meca-hyprconfig.sh" \
    "$HOOKS_DIR/post-update.d/00-lizarbe-update.hook"; do
    # Solo si el paquete ya trae el programa (no se quita lo único que hay).
    case $f in
      */.local/bin/lizarbe-escritorio | */.local/bin/lizarbe-widgets | */.local/bin/lizarbe-temas | */.local/bin/lizarbe-tienda)
        [[ -x /usr/bin/${f##*/} ]] || continue ;;
      */.local/bin/lizarbe | */.local/bin/lizarbe-tui | */.local/bin/lizarbe-update)
        # Copias o enlaces del Centro de antes del paquete lizarbe-centro.
        [[ -x /usr/bin/lizarbe && -x /usr/bin/lizarbe-tui ]] || continue ;;
      */post-update.d/00-lizarbe-update.hook)
        # El hook viejo actualizaba por git; ahora actualiza pacman (paquete lizarbe-centro).
        [[ -x /usr/bin/lizarbe && -f /usr/lib/lizarbe-centro/install.sh ]] || continue ;;
      "$apps"/lizarbe*.desktop)
        # Una copia en el usuario tapa la del paquete en el lanzador.
        [[ -f /usr/share/applications/${f##*/} ]] || continue ;;
    esac
    if [[ -e $f || -L $f ]]; then
      found=1
      problem "resto de una versión anterior: $f" rm -f "$f"
    fi
  done
  # Enlaces de temas e iconos que apuntan a la carpeta /opt del instalador viejo:
  # los temas y los iconos ya están en /usr/share (paquete lizarbe-tema).
  if [[ -d /usr/share/omarchy/themes/lizarbe && -d /usr/share/icons/Lizarbe-Red ]]; then
    for f in "$HOME/.config/omarchy/themes/lizarbe" "$HOME/.config/omarchy/themes/lizarbe-light" \
      "$HOME/.local/share/icons/Lizarbe-Red" "$HOME/.icons/Lizarbe-Red"; do
      if [[ -L $f && "$(readlink "$f")" == /opt/Lizarbe-Omarchy-Theme/* ]]; then
        found=1
        problem "enlace al instalador viejo: $f" rm -f "$f"
      fi
    done
  fi
  # Archivos de root del instalador viejo: solo se pueden quitar con sudo.
  local root_left=()
  for f in /opt/Lizarbe-Omarchy-Theme /usr/local/bin/lizarbe /usr/local/bin/lizarbe-tui /usr/local/bin/lizarbe-update \
    /usr/local/bin/lizarbe-apply-user /usr/local/bin/lizarbe-hypr-rules /usr/local/bin/lizarbe-provision-owner-post \
    /etc/systemd/system/omarchy-provision-owner.service.d/lizarbe.conf; do
    [[ -e $f || -L $f ]] && root_left+=("$f")
  done
  if [[ ${#root_left[@]} -gt 0 && -x /usr/bin/lizarbe && -x /usr/bin/lizarbe-apply-user ]]; then
    found=1
    bad "quedan archivos del instalador viejo (los reemplazan los paquetes). Quítalos con: sudo rm -rf ${root_left[*]}"
  fi
  [[ $found -eq 0 ]] && ok "sin restos"
}

# ---------------------------------------------------------------- aplicaciones
check_apps() {
  say "Aplicaciones de Lizarbe"
  local missing=() b
  for b in lizarbe-escritorio lizarbe-widgets lizarbe-temas lizarbe-tienda lizarbe; do
    command -v "$b" >/dev/null || missing+=("$b")
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "Escritorio, Widgets, Estudio de temas, Tienda y Centro instalados"
  else
    bad "faltan ${missing[*]} (instala el metapaquete: sudo pacman -S lizarbe)"
  fi
  # Capturas (Escritorio): el bloque de ~/.config/uwsm/env apunta a una carpeta
  # y a un editor; si no existen, la tecla de captura no hará lo esperado.
  local env="$HOME/.config/uwsm/env" dir editor
  if [[ -f $env ]] && grep -q '^# >>> lizarbe capturas' "$env"; then
    dir=$(sed -n 's/^export OMARCHY_SCREENSHOT_DIR="\(.*\)"$/\1/p' "$env" | tail -1)
    editor=$(sed -n 's/^export OMARCHY_SCREENSHOT_EDITOR="\(.*\)"$/\1/p' "$env" | tail -1)
    [[ -n $dir && ! -d $dir ]] && say "  \033[33m!\033[0m la carpeta de capturas no existe todavía ($dir): se creará con la primera captura"
    if [[ -n $editor ]] && ! command -v "$editor" >/dev/null; then
      bad "el editor de capturas elegido no está instalado: $editor (cámbialo en Escritorio › Capturas)"
    else
      ok "capturas configuradas"
    fi
  fi
}

# ---------------------------------------------------------------- notificaciones
# Si swaync puede arrancar, a veces les gana el puesto al shell de Omarchy y los
# avisos salen con otro estilo. Solo se avisa: la decisión es del usuario
# (Widgets y barra › Notificaciones).
check_notifications() {
  say "Notificaciones"
  command -v busctl >/dev/null && command -v swaync >/dev/null || { ok "sin otros programas de avisos"; return; }
  local owner blocked=0
  [[ -f $HOME/.local/share/dbus-1/services/org.freedesktop.Notifications.service ]] && blocked=1
  owner=$(busctl --user status org.freedesktop.Notifications 2>/dev/null | sed -n 's/^Comm=//p')
  if [[ $blocked -eq 1 && ${owner:-quickshell} == quickshell ]]; then
    ok "los avisos los muestra el shell de Omarchy"
  elif [[ -n $owner && $owner != quickshell ]]; then
    say "  \033[33m!\033[0m los avisos los muestra «$owner», no el shell de Omarchy (estilos mezclados). Arréglalo en Widgets y barra › Notificaciones"
  else
    say "  \033[33m!\033[0m swaync está instalado y puede mezclar el estilo de los avisos. Puedes bloquearlo en Widgets y barra › Notificaciones"
  fi
}

# ---------------------------------------------------------------- archivos de Omarchy
check_omarchy_files() {
  say "Archivos de Omarchy"
  command -v pacman >/dev/null || return
  local mod
  # Solo cuenta si el contenido cambió (tamaño o suma de comprobación); la hora
  # o los permisos de lectura no importan.
  mod=$(pacman -Qkk omarchy omarchy-settings 2>&1 | grep -E 'Size mismatch|checksum mismatch' |
    sed -E 's/^warning: [^:]+: ([^ ]+) .*/\1/' | sort -u | head -8)
  if [[ -z $mod ]]; then
    ok "ninguno modificado"
  else
    bad "hay archivos de Omarchy modificados (un update los puede revertir):"
    say "$(echo "$mod" | sed 's/^/      /')"
    say "      Para restaurarlos: sudo pacman -S omarchy omarchy-settings"
  fi
}

# ---------------------------------------------------------------- repo pacman
check_repo() {
  say "Repositorio de Lizarbe"
  if [[ ! -r /etc/pacman.d/lizarbe.conf ]]; then
    ok "no instalado todavía (se instala con lizarbe-menu)"
    return
  fi
  if grep -qxF 'Include = /etc/pacman.d/lizarbe.conf' /etc/pacman.conf 2>/dev/null; then
    ok "pacman.conf incluye el repo"
  elif sudo -n true 2>/dev/null; then
    problem "pacman.conf no incluye el repo de Lizarbe" sudo sed -i '0,/^\[core\]/s||Include = /etc/pacman.d/lizarbe.conf\n\n[core]|' /etc/pacman.conf
  else
    bad "pacman.conf no incluye el repo de Lizarbe (ejecuta: lizarbe-doctor --fix con sudo)"
  fi
}

say "Lizarbe Doctor"
check_menu
check_rules
check_hooks
check_legacy
check_apps
check_notifications
check_omarchy_files
check_repo

if [[ $RELOAD -eq 1 ]] && command -v hyprctl >/dev/null && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  hyprctl reload >/dev/null 2>&1 || true
  errors=$(hyprctl configerrors 2>/dev/null | tr -d '[:space:]')
  [[ -n $errors ]] && say "  \033[31m✘\033[0m Hyprland informa errores de configuración: ejecuta hyprctl configerrors"
fi

if [[ $FIX -eq 1 ]]; then
  say "\nListo: $FIXED cosa(s) arreglada(s)."
  [[ $PROBLEMS -eq 0 ]] && exit 0 || exit 1
fi
if [[ $PROBLEMS -gt 0 ]]; then
  say "\nHay $PROBLEMS cosa(s) por arreglar. Ejecuta: lizarbe-doctor --fix"
  exit 1
fi
say "\nTodo en orden."
exit 0
