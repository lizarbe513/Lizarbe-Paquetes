# Maintainer: Lizarbe <lizarbe513>
pkgname=lizarbe-ajustes
pkgver=1.5.0
pkgrel=1
pkgdesc='Escritorio, Widgets, Desbloqueo, Tienda, Bienvenida y Recibir: paneles TUI para configurar Omarchy, instalar aplicaciones y aprender a usarlo'
arch=('x86_64')
url='https://github.com/lizarbe513/Lizarbe-Ajustes'
license=('MIT')
depends=('omarchy' 'gcc-libs')
optdepends=('satty: editor de capturas alternativo'
            'swappy: editor de capturas alternativo'
            'kdeconnect: conectar el teléfono desde la Bienvenida'
            'fastfetch: la terminal de prueba de la Bienvenida lo muestra')
makedepends=('cargo' 'git')
options=('!debug')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --release --frozen -p lizarbe-escritorio -p lizarbe-widgets -p lizarbe-desbloqueo -p lizarbe-tienda -p lizarbe-bienvenida -p lizarbe-recibir
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/lizarbe-escritorio "$pkgdir/usr/bin/lizarbe-escritorio"
  install -Dm755 target/release/lizarbe-widgets "$pkgdir/usr/bin/lizarbe-widgets"
  install -Dm755 target/release/lizarbe-desbloqueo "$pkgdir/usr/bin/lizarbe-desbloqueo"
  install -Dm755 target/release/lizarbe-tienda "$pkgdir/usr/bin/lizarbe-tienda"
  install -Dm755 target/release/lizarbe-bienvenida "$pkgdir/usr/bin/lizarbe-bienvenida"
  install -Dm755 target/release/lizarbe-recibir "$pkgdir/usr/bin/lizarbe-recibir"
  install -Dm644 crates/escritorio/lizarbe-escritorio.desktop "$pkgdir/usr/share/applications/lizarbe-escritorio.desktop"
  install -Dm644 crates/widgets/lizarbe-widgets.desktop "$pkgdir/usr/share/applications/lizarbe-widgets.desktop"
  install -Dm644 crates/desbloqueo/lizarbe-desbloqueo.desktop "$pkgdir/usr/share/applications/lizarbe-desbloqueo.desktop"
  install -Dm644 crates/tienda/lizarbe-tienda.desktop "$pkgdir/usr/share/applications/lizarbe-tienda.desktop"
  install -Dm644 crates/bienvenida/lizarbe-bienvenida.desktop "$pkgdir/usr/share/applications/lizarbe-bienvenida.desktop"
  install -Dm644 crates/recibir/lizarbe-recibir.desktop "$pkgdir/usr/share/applications/lizarbe-recibir.desktop"
}
