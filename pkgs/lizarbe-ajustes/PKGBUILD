# Maintainer: Lizarbe <lizarbe513>
pkgname=lizarbe-ajustes
pkgver=0.8.2
pkgrel=1
pkgdesc='Escritorio, Widgets, Estudio de temas y Tienda: paneles TUI para configurar Omarchy e instalar aplicaciones'
arch=('x86_64')
url='https://github.com/lizarbe513/Lizarbe-Ajustes'
license=('MIT')
depends=('omarchy' 'gcc-libs')
optdepends=('grim: captura automática de la vista previa de un tema'
            'satty: editor de capturas alternativo'
            'swappy: editor de capturas alternativo')
makedepends=('cargo' 'git')
options=('!debug')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --release --frozen -p lizarbe-escritorio -p lizarbe-widgets -p lizarbe-temas -p lizarbe-tienda
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/lizarbe-escritorio "$pkgdir/usr/bin/lizarbe-escritorio"
  install -Dm755 target/release/lizarbe-widgets "$pkgdir/usr/bin/lizarbe-widgets"
  install -Dm755 target/release/lizarbe-temas "$pkgdir/usr/bin/lizarbe-temas"
  install -Dm755 target/release/lizarbe-tienda "$pkgdir/usr/bin/lizarbe-tienda"
  install -Dm644 crates/escritorio/lizarbe-escritorio.desktop "$pkgdir/usr/share/applications/lizarbe-escritorio.desktop"
  install -Dm644 crates/widgets/lizarbe-widgets.desktop "$pkgdir/usr/share/applications/lizarbe-widgets.desktop"
  install -Dm644 crates/temas/lizarbe-temas.desktop "$pkgdir/usr/share/applications/lizarbe-temas.desktop"
  install -Dm644 crates/tienda/lizarbe-tienda.desktop "$pkgdir/usr/share/applications/lizarbe-tienda.desktop"
}
